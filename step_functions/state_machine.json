{
  "Comment": "Manual nurse staffing pipeline - ingestion plus standardization",
  "StartAt": "IngestFilesFromGoogleDrive",
  "States": {
    "IngestFilesFromGoogleDrive": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:us-east-1:778277577883:function:nurse-staffing-lambda-function",
        "Payload": {
          "run_id": "{% $states.input.run_id %}",
          "bucket_name": "{% $states.input.bucket_name %}",
          "raw_prefix": "{% $states.input.raw_prefix %}",
          "manifest_prefix": "{% $states.input.manifest_prefix %}"
        }
      },
      "Output": "{% $states.result.Payload %}",
      "Next": "RunRefineJob",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "SNS Publish"
        }
      ]
    },
    "SNS Publish": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "Message": "{% $states.input %}",
        "TopicArn": "arn:aws:sns:us-east-1:778277577883:nurse-staffing-alerts"
      },
      "End": true,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "IntervalSeconds": 1,
          "MaxAttempts": 3
        }
      ]
    },
    "RunRefineJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "nurse-staffing-refine",
        "Arguments": {
          "--bucket_name": "{% $states.input.bucket_name %}",
          "--manifest_key": "{% $states.input.manifest_key %}",
          "--run_id": "{% $states.input.run_id %}"
        }
      },
      "Output": {
        "bucket_name": "{% $states.input.bucket_name %}",
        "run_id": "{% $states.input.run_id %}",
        "manifest_key": "{% $states.input.manifest_key %}"
      },
      "Next": "RunValidationJob",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "MaxAttempts": 2,
          "IntervalSeconds": 30
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "SNS Publish"
        }
      ]
    },
    "RunValidationJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "nurse-staffing-validate",
        "Arguments": {
          "--bucket_name": "{% $states.input.bucket_name %}",
          "--run_id": "{% $states.input.run_id %}"
        }
      },
      "Output": {
        "bucket_name": "{% $states.input.bucket_name %}",
        "run_id": "{% $states.input.run_id %}"
      },
      "Next": "RunCurateJob",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "SNS Publish"
        }
      ]
    },
    "RunCurateJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "nurse-staffing-curate",
        "Arguments": {
          "--bucket_name": "{% $states.input.bucket_name %}",
          "--run_id": "{% $states.input.run_id %}"
        }
      },
      "End": true,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "IntervalSeconds": 30,
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "SNS Publish"
        }
      ]
    }
  },
  "QueryLanguage": "JSONata"
}